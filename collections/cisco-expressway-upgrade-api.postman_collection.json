          "id": "54cd0061-bcf4-4618-b9fe-cfb40219516c",
          "name": "Cisco Expressway Retrieve upgrade progress status",
          "request": {
            "name": "Cisco Expressway Retrieve upgrade progress status",
            "description": {
              "content": "Returns the current status of any in-progress or recent system upgrade on the Expressway, including the download progress percentage, upgrade phase, and any error messages. This endpoint is documented in the Cisco Expressway REST API Summary Guide as a primary status retrieval endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "status",
                "common",
                "upgradestatus"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [

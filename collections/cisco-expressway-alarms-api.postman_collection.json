                "status",
                "common",
                "alarms"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The FQDN or IP address of the Cisco Expressway node. The API is only accessible via HTTPS.",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                }
              ]
            },

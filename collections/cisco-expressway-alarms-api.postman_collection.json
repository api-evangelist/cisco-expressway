          "name": "Cisco Expressway List all active alarms",
          "request": {
            "name": "Cisco Expressway List all active alarms",
            "description": {
              "content": "Retrieves the list of all alarms currently active on the Expressway. Alarms indicate events or configuration changes that require administrator intervention, or hardware and environmental issues such as faulty disks, fans, or high temperatures. Alarms are categorized by severity and ID prefix ranges.",
              "type": "text/plain"
            },
            "url": {
